<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationManifest>App.manifest</ApplicationManifest>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- ユーザー環境で DOTNET_SYSTEM_GLOBALIZATION_INVARIANT が有効でもクラッシュしないよう明示的に無効化する -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!--
      Trim 解析警告は意図的に抑制する。理由:
      下の <TrimmerRootAssembly Include="Komorebi" /> でアセンブリ全体を root 化しており、
      App.CreateViewForViewModel が Type.GetType / Activator.CreateInstance で動的解決する
      Views.* も含めて全型が保持される。Avalonia / CommunityToolkit.Mvvm / Velopack 等
      サードパーティ側の警告は対処不能なノイズになるため一括抑制する。
      Komorebi 自身のコードで AOT 安全性に懸念がある箇所には個別に
      [UnconditionalSuppressMessage] / [DynamicDependency] 属性を付けて意図を明示する。
    -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <!--
      IL3053 は「このアセンブリが AOT 解析警告を出した」という第三者アセンブリ単位の集約通知で、
      対象 (Avalonia.Controls.DataGrid / Velopack 等) は自前で直せない。TreatWarningsAsErrors=true と
      併用すると ILC 実行時にエラー化して AOT publish が失敗するため抑制する (Lhamiel / Kiriha と同じ対処)。
      自コード側の個別指摘である IL3050 は抑制しない — こちらは実際に書き換えて解消済み。
    -->
    <NoWarn>$(NoWarn);IL3053</NoWarn>
    <!-- LibraryImport source generator が marshalling stub に unsafe コードを生成するため必要 (ユーザーコードに unsafe を許可するわけではない) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <Product>Komorebi</Product>
    <Description>OpenSource GIT client</Description>
    <Authors>Kagayoi</Authors>
    <Company>Kagayoi</Company>
    <Copyright>Copyright © $([System.DateTime]::Now.Year) Kagayoi.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/1llum1n4t1s/Komorebi</PackageProjectUrl>
    <RepositoryUrl>https://github.com/1llum1n4t1s/Komorebi.git</RepositoryUrl>
    <RepositoryType>Public</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(DisableAOT)' != 'true'">
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <!-- TrimMode は指定しない。Native AOT が常に full トリムを行うため (公式に AOT 併用時は設定しない指針)。
         旧値 'link' は .NET 6 以前の名称で、現在の有効値は full / partial のみ。 -->
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DisableUpdateDetection)' == 'true'">
    <DefineConstants>$(DefineConstants);DISABLE_UPDATE_DETECTION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildDate" Value="$([System.DateTime]::Now.ToString('o'))" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Komorebi.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="App.ico" />
    <AvaloniaResource Include="Resources/Grammars/*" />
    <AvaloniaResource Include="Resources/Images/*" />
    <AvaloniaResource Include="Resources/Images/ExternalToolIcons/*" />
    <AvaloniaResource Include="Resources/Images/ExternalToolIcons/JetBrains/*" />
    <AvaloniaResource Include="Resources/Images/ShellIcons/*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Azure.AI.OpenAI" Version="2.9.0-beta.1" />
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CRDebugger.Avalonia" Version="1.0.28" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" Version="2.0.5" />
    <PackageReference Include="OpenAI" Version="2.12.0" />
    <PackageReference Include="Pfim" Version="0.11.4" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <PackageReference Include="SuperLightLogger" Version="1.0.10" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.2" />
    <PackageReference Include="VelopackUpdateDialog.Avalonia" Version="1.0.13" />

    <ProjectReference Include="../depends/AvaloniaEdit/src/AvaloniaEdit.TextMate/AvaloniaEdit.TextMate.csproj" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Komorebi" />
    <TrimmerRootAssembly Include="Avalonia.Themes.Fluent" />
    <TrimmerRootAssembly Include="Velopack" />
  </ItemGroup>
</Project>
