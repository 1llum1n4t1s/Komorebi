<Project>
  <PropertyGroup>
    <Version>1.1.5</Version>
    <!-- IDEコードスタイル分析（IDE0005等）をビルド時にも強制する -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- IDE0005（不要なusing検出）にはドキュメント生成が必須 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- XMLドキュメントコメント未記載の警告（CS1591）を抑制する -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- NuGet 依存のサプライチェーン保護: lockfile を生成・検証する -->
    <!-- packages.lock.json により「リパッケージ攻撃」(既存バージョンの差し替え) を検知可能 -->
    <!-- Condition: 同梱依存 (depends/AvaloniaEdit。submodule ではなく直接追跡) では lockfile を生成しない。 -->
    <!--            上流から取り込む同梱物で、Komorebi 側の lockfile 運用の対象外とするため。 -->
    <RestorePackagesWithLockFile Condition="!$(MSBuildProjectDirectory.Contains('depends'))">true</RestorePackagesWithLockFile>
    <!-- CI ビルド時の固定復元。構成・AOT・RIDによる依存グラフの差は
         Directory.Build.targetsで別lockfileへ分け、通常Debugの正本を保護する。
         新しい構成やSDK由来のAOTツール更新時は、対象lockを明示的に再生成する。 -->
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true' And !$(MSBuildProjectDirectory.Contains('depends'))">true</RestoreLockedMode>
    <Nullable>enable</Nullable>
    <!-- 警告をエラー扱いにして品質ゲートを他リポジトリと揃える。 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
